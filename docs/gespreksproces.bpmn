<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Minorly" targetNamespace="https://Minorly.example/bpmn" exporter="Minorly">
  <bpmn:process id="Process_Minorly" name="Minorly gespreksproces" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>relax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endNo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endYes</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UI" name="Voice/UI">
        <bpmn:flowNodeRef>notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>links</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Minorly Agent">
        <bpmn:flowNodeRef>study</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>interests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>followup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>uncertain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>advisor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>explain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>again</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>processNew</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Database" name="Minor Database">
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Start" />
    <bpmn:task id="notice" name="AI-transparantiemelding tonen" />
    <bpmn:task id="study" name="Studieachtergrond vragen" />
    <bpmn:task id="interests" name="Interesses vragen" />
    <bpmn:exclusiveGateway id="enough" name="Voldoende informatie?" />
    <bpmn:task id="followup" name="Gerichte vervolgvraag" />
    <bpmn:task id="search" name="Dataset zoeken" />
    <bpmn:exclusiveGateway id="found" name="Kandidaten gevonden?" />
    <bpmn:task id="uncertain" name="Onzekerheid melden" />
    <bpmn:task id="relax" name="Voorkeur versoepelen" />
    <bpmn:task id="advisor" name="Verwijs naar studieadviseur" />
    <bpmn:endEvent id="endNo" name="Stop" />
    <bpmn:task id="rank" name="Kandidaten ranken" />
    <bpmn:task id="select" name="Maximaal 3 selecteren" />
    <bpmn:task id="explain" name="Gepersonaliseerde uitleg" />
    <bpmn:task id="show" name="Tonen en uitspreken" />
    <bpmn:exclusiveGateway id="again" name="Vervolgvraag?" />
    <bpmn:task id="processNew" name="Verzoek verwerken" />
    <bpmn:task id="links" name="Officiële bronlinks tonen" />
    <bpmn:endEvent id="endYes" name="Einde" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="notice" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="notice" targetRef="study" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="study" targetRef="interests" />
