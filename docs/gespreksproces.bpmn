    <bpmn:sequenceFlow id="Flow_21" sourceRef="processNew" targetRef="show" name="Details" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="again" targetRef="links" name="Nee" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="links" targetRef="endYes" />
  </bpmn:process>
